[Unit]
Description=MITRE Caldera Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory={{ ludus_caldera_server_install_dir }}
Environment="PATH={{ caldera_service_path.stdout }}"
# Modified for VibeRange: run the role-managed Python runtime directly.
ExecStart={{ ludus_caldera_server_install_dir }}/.venv/bin/python server.py{% if ludus_caldera_server_insecure %} --insecure{% endif %}

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
