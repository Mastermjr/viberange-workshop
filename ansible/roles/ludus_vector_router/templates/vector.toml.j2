data_dir = "/var/lib/vector"

[sources.zeek]
type = "file"
include = {{ ludus_vector_router_zeek_globs | to_json }}
read_from = "end"
max_line_bytes = 10485760

[sources.zeek.fingerprint]
strategy = "device_and_inode"

[sources.pcap_artifacts]
type = "file"
include = {{ ludus_vector_router_artifact_globs | to_json }}
read_from = "beginning"
max_line_bytes = 1048576

[sources.pcap_artifacts.fingerprint]
strategy = "device_and_inode"

[sources.vector_internal_logs]
type = "internal_logs"

[transforms.zeek_envelope]
type = "remap"
inputs = ["zeek"]
source = '''
.source_type = "zeek"
.source_host = "{{ ludus_vector_router_source_host }}"
.range_id = "{{ ludus_vector_router_range_id }}"
'''

[transforms.pcap_artifact_envelope]
type = "remap"
inputs = ["pcap_artifacts"]
source = '''
.source_type = "pcap_artifact"
.source_host = "{{ ludus_vector_router_source_host }}"
.range_id = "{{ ludus_vector_router_range_id }}"
'''

[transforms.internal_log_envelope]
type = "remap"
inputs = ["vector_internal_logs"]
source = '''
.source_type = "vector_internal"
.source_host = "{{ ludus_vector_router_source_host }}"
.range_id = "{{ ludus_vector_router_range_id }}"
'''

[sinks.central_vector]
type = "vector"
inputs = ["zeek_envelope", "pcap_artifact_envelope"]
address = "{{ ludus_vector_router_aggregator_address }}"
version = "2"

[sinks.central_vector.acknowledgements]
enabled = true

[sinks.central_vector.buffer]
type = "disk"
max_size = {{ ludus_vector_router_disk_buffer_bytes }}
when_full = "block"

[sinks.central_vector_health]
type = "vector"
inputs = ["internal_log_envelope"]
address = "{{ ludus_vector_router_aggregator_address }}"
version = "2"
